{{>layout/header}}

<div class="container mt-4">
    <h2 class="mb-3">재활용 데이터 시각화</h2>
    <p class="text-muted">master_1to3.csv 업로드 후 Python 분석을 실행합니다.</p>

    <div class="card mb-4">
        <div class="card-body">
            <form action="/data/upload" method="post" enctype="multipart/form-data">
                <div class="mb-2">
                    <label class="form-label">master_1to3.csv (필수)</label>
                    <input type="file" class="form-control" name="file" required>
                </div>
                <div class="mb-2">
                    <label class="form-label">summary_stats.csv (선택)</label>
                    <input type="file" class="form-control" name="summary">
                </div>
                <div class="mb-2">
                    <label class="form-label">facilities.csv (선택)</label>
                    <input type="file" class="form-control" name="facilities">
                </div>
                <div class="mb-3">
                    <label class="form-label">material_mapping.csv (선택)</label>
                    <input type="file" class="form-control" name="mapping">
                </div>
                <button class="btn btn-primary" type="submit">업로드 & 분석 실행</button>
            </form>
            <p class="mt-3 mb-0">현재 상태: <strong>{{status}}</strong></p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">지표/랭킹</h5>
                    <a class="btn btn-outline-secondary w-100 mb-2" href="/data/download/indicators.csv">indicators.csv</a>
                    <a class="btn btn-outline-secondary w-100" href="/data/download/summary_stats_copy.csv">summary_stats_copy.csv</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">갭 분석</h5>
                    <a class="btn btn-outline-secondary w-100 mb-2" href="/data/download/gap_table.csv">gap_table.csv</a>
                    <a class="btn btn-outline-secondary w-100" href="/data/download/top_gap_list.txt">top_gap_list.txt</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">차트 PNG</h5>
                    <a class="btn btn-outline-secondary w-100 mb-2" href="/outputs/chart_region.png">chart_region.png</a>
                    <a class="btn btn-outline-secondary w-100 mb-2" href="/outputs/chart_material.png">chart_material.png</a>
                    <a class="btn btn-outline-secondary w-100" href="/outputs/chart_trend.png">chart_trend.png</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">지역별 재활용률</h5>
                    <img class="img-fluid" src="/outputs/chart_region.png" alt="지역별 재활용률">
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">재질별 재활용률</h5>
                    <img class="img-fluid" src="/outputs/chart_material.png" alt="재질별 재활용률">
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">월별 추이</h5>
            <img class="img-fluid" src="/outputs/chart_trend.png" alt="월별 재활용률 추이">
        </div>
    </div>
</div>

{{>layout/footer}}

