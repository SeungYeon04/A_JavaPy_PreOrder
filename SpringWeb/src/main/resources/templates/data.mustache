{{>layout/header}}

<div class="container mt-4">
    <h2 class="mb-3">재활용 데이터 시각화</h2>
    <p class="text-muted">데이터 분석 결과가 아래에 표시됩니다.</p>
    <p class="mb-3">현재 상태: <strong>{{status}}</strong></p>



    <div class="row">
        <div class="col-12 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">생성된 차트 갤러리</h5>
                    <div class="row">
                    {{#outputs}}
                    {{#isImage}}
                    <div class="col-md-6 col-sm-12 mb-4 d-flex align-items-stretch">
                        <div class="card w-100 p-2">
                            <div class="card-body d-flex flex-column">
                                <strong class="mb-2 text-truncate" style="font-size:1.05rem">{{title}}</strong>
                                <div class="text-muted small mb-2">{{name}}</div>
                                <div class="mb-2">
                                    <a class="btn btn-sm btn-outline-secondary" href="/analysis_outputs/{{name}}" target="_blank">원본 보기</a>
                                </div>
                                <div class="flex-fill d-flex justify-content-center align-items-center">
                                    <img class="img-fluid" src="/analysis_outputs/{{name}}" alt="{{name}}" style="width:100%; height:auto; object-fit:contain;"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/isImage}}
                    {{/outputs}}
                    </div>
                </div>
            </div>
        </div>
    </div>

{{>layout/footer}}

